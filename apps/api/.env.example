# --- Application Configuration ---
NODE_ENV=development
CORS_ORIGIN=["http://localhost:3000", "http://localhost:3001", "http://localhost:3002"]

# --- JWT Configuration ---
# Access Token (15 minutes)
JWT_ACCESS_SECRET=jwt_access_secret_key
JWT_ACCESS_EXPIRES_IN_SECONDS=900

# Refresh Token (30 days)
JWT_REFRESH_SECRET=jwt_refresh_secret_key
JWT_REFRESH_EXPIRES_IN_SECONDS=2592000

# Password Reset Token (15 minutes)
RESET_PASSWORD_TOKEN_EXPIRES_IN_SECONDS=900

# Verify Email Token (24 hours) 
VERIFY_EMAIL_TOKEN_EXPIRES_IN_SECONDS=86400

# --- Cookie Configuration ---
AUTH_COOKIE_ACCESS_NAME=ecommerce_access_token
AUTH_COOKIE_REFRESH_NAME=ecommerce_refresh_token
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_OAUTH_STATE_NAME=ecommerce_oauth_state
AUTH_COOKIE_STATE_MAX_AGE_SECONDS=300

# --- Google OAuth Configuration ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8080/api/v1/auth/google/callback

# --- Frontend Redirect URIs ---
FRONTEND_LOGIN_SUCCESS_REDIRECT=http://localhost:3000/auth/callback/success
FRONTEND_LOGIN_FAILURE_REDIRECT=http://localhost:3000/auth/callback/error
# Thay đổi redirect URI để phù hợp với backend (test)
# FRONTEND_LOGIN_SUCCESS_REDIRECT=http://localhost:8080/api/v1/auth/me
# FRONTEND_LOGIN_FAILURE_REDIRECT=http://localhost:8080/docs

FRONTEND_RESET_PASSWORD_REDIRECT=http://localhost:3000/reset-password
FRONTEND_VERIFY_EMAIL_REDIRECT=http://localhost:3000/verify-email

# --- SMTP Configuration for Email (Optional) ---
MAIL_ENABLED=false
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURE=false
MAIL_SMTP_CONNECTION_TIMEOUT=10000
MAIL_FROM_EMAIL=your_sender_email
MAIL_FROM_NAME=Your Sender Name
GMAIL_SMTP_USER=your_smtp_username
GMAIL_SMTP_APP_PASSWORD=your_smtp_password

# --- Database Configuration ---
DATABASE_URL=
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT=30000

# --- MinIO Configuration ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=minio_root_user
MINIO_ROOT_PASSWORD=minio_root_password
MINIO_SECURE=false
MINIO_REGION=us-east-1
MINIO_BUCKETS=products,evidence,avatars
MINIO_PUBLIC_BUCKETS=products
# Browser-facing endpoint. Use HTTPS in production, e.g. https://storage.example.com
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_PRESIGNED_URL_EXPIRES_IN_SECONDS=900

# --- VNPay Configuration (Sandbox) ---
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_SECURE_SECRET=your_vnpay_secure_secret
VNPAY_HOST=https://sandbox.vnpayment.vn
VNPAY_RETURN_URL=http://localhost:3000/checkout/confirmation
VNPAY_IPN_URL=http://localhost:8080/api/v1/payments/vnpay/ipn
VNPAY_LOCALE=vn
VNPAY_ORDER_TYPE=other
VNPAY_PAYMENT_EXPIRE_MINUTES=15

# --- Settlement Configuration ---
SETTLEMENT_ADMIN_COMMISSION_PERCENT=5
