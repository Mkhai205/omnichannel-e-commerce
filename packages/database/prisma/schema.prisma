generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(uuid()) @db.Uuid
  email          String          @unique @db.VarChar(255)
  passwordHash   String?         @map("password_hash") @db.VarChar(255)
  fullName       String          @map("full_name") @db.VarChar(255)
  phone          String?         @unique @db.VarChar(20)
  role           UserRole        @default(CUSTOMER)
  status         UserStatus      @default(ACTIVE)
  shop           Shop?
  cart           Cart?
  addresses      Address[]
  oauthAccounts  OauthAccount[]
  refreshTokens  RefreshToken[]
  productReviews ProductReview[]
  orders         Order[]
  payments       Payment[]
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@map("users")
}

model Shop {
  id              String             @id @default(uuid()) @db.Uuid
  userId          String             @unique @map("user_id") @db.Uuid
  shopName        String             @map("shop_name") @db.VarChar(255)
  slug            String             @unique @db.VarChar(255)
  description     String?            @db.Text
  avatarKey       String?            @map("avatar_key") @db.VarChar(500)
  coverKey        String?            @map("cover_key") @db.VarChar(500)
  businessLicense String?            @map("business_license") @db.VarChar(255)
  status          ShopStatus         @default(PENDING)
  rejectionReason String?            @map("rejection_reason") @db.VarChar(500)
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  products        Product[]
  orders          Order[]
  sellerWallet    SellerWallet?
  settlements     SellerSettlement[]

  @@index([status])
  @@map("shops")
}

model Category {
  id        String     @id @default(uuid()) @db.Uuid
  parentId  String?    @map("parent_id") @db.Uuid
  name      String     @db.VarChar(255)
  slug      String     @unique @db.VarChar(255)
  imageKey  String?    @map("image_key") @db.VarChar(500)
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@index([parentId])
  @@map("categories")
}

model Product {
  id            String           @id @default(uuid()) @db.Uuid
  shopId        String           @map("shop_id") @db.Uuid
  categoryId    String           @map("category_id") @db.Uuid
  name          String           @db.VarChar(255)
  description   String?          @db.Text
  imageKey      String?          @map("image_key") @db.VarChar(500)
  status        ProductStatus    @default(DRAFT)
  ratingAverage Decimal          @default(0) @map("rating_average") @db.Decimal(3, 2)
  ratingCount   Int              @default(0) @map("rating_count")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  shop          Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category      Category         @relation(fields: [categoryId], references: [id])
  variants      ProductVariant[]
  reviews       ProductReview[]

  @@index([shopId])
  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model ProductVariant {
  id            String      @id @default(uuid()) @db.Uuid
  productId     String      @map("product_id") @db.Uuid
  sku           String      @unique @db.VarChar(100)
  attributes    Json
  price         Decimal     @db.Decimal(12, 2)
  imageKey      String?     @map("image_key") @db.VarChar(500)
  stockQuantity Int         @default(0) @map("stock_quantity")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems     CartItem[]
  orderItems    OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model ProductReview {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  rating    Int      @db.SmallInt
  comment   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
  @@map("product_reviews")
}

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @unique @map("user_id") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@index([userId])
  @@map("carts")
}

model CartItem {
  id        String         @id @default(uuid()) @db.Uuid
  cartId    String         @map("cart_id") @db.Uuid
  variantId String         @map("variant_id") @db.Uuid
  quantity  Int
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
  @@map("cart_items")
}

model Address {
  id               String      @id @default(uuid()) @db.Uuid
  userId           String      @map("user_id") @db.Uuid
  type             AddressType @default(HOME)
  recipientName    String      @map("recipient_name") @db.VarChar(255)
  recipientPhone   String      @map("recipient_phone") @db.VarChar(20)
  streetAddress    String      @map("street_address") @db.VarChar(255)
  wardDistrict     String?     @map("ward_district") @db.VarChar(255)
  city             String      @db.VarChar(100)
  state            String      @db.VarChar(100)
  postalCode       String      @map("postal_code") @db.VarChar(20)
  country          String      @db.VarChar(100)
  isDefault        Boolean     @default(false) @map("is_default")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  ordersAsShipping Order[]

  @@index([userId])
  @@map("addresses")
}

model OauthAccount {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  provider       AuthProvider
  providerUserId String       @map("provider_user_id") @db.VarChar(255)
  email          String?      @db.VarChar(255)
  picture        String?      @db.VarChar(255)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@map("oauth_accounts")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent") @db.VarChar(255)
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Order {
  id                String              @id @default(uuid()) @db.Uuid
  orderNumber       String              @unique @map("order_number") @db.VarChar(50)
  userId            String              @map("user_id") @db.Uuid
  shopId            String              @map("shop_id") @db.Uuid
  shippingAddressId String              @map("shipping_address_id") @db.Uuid
  status            OrderStatus         @default(PENDING_PAYMENT)
  shippedAt         DateTime?           @map("shipped_at")
  deliveredAt       DateTime?           @map("delivered_at")
  settlementStatus  SettlementStatus    @default(PENDING) @map("settlement_status")
  settledAt         DateTime?           @map("settled_at")
  subtotal          Decimal             @db.Decimal(12, 2)
  totalAmount       Decimal             @map("total_amount") @db.Decimal(12, 2)
  note              String?             @db.Text
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop              Shop                @relation(fields: [shopId], references: [id])
  shippingAddress   Address             @relation(fields: [shippingAddressId], references: [id])
  items             OrderItem[]
  paymentOrders     PaymentOrder[]
  adminWalletLogs   AdminWalletLedger[]
  sellerSettlement  SellerSettlement?

  @@index([userId])
  @@index([shopId])
  @@index([shippingAddressId])
  @@index([status])
  @@index([shippedAt])
  @@index([settlementStatus])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        String         @id @default(uuid()) @db.Uuid
  orderId   String         @map("order_id") @db.Uuid
  variantId String         @map("variant_id") @db.Uuid
  quantity  Int
  unitPrice Decimal        @map("unit_price") @db.Decimal(12, 2)
  lineTotal Decimal        @map("line_total") @db.Decimal(12, 2)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

model Payment {
  id                   String              @id @default(uuid()) @db.Uuid
  userId               String              @map("user_id") @db.Uuid
  provider             PaymentProvider
  status               PaymentStatus       @default(PENDING)
  txnRef               String              @unique @map("txn_ref") @db.VarChar(100)
  gatewayTransactionNo String?             @map("gateway_transaction_no") @db.VarChar(100)
  amount               Decimal             @db.Decimal(12, 2)
  currency             String              @default("VND") @db.VarChar(10)
  bankCode             String?             @map("bank_code") @db.VarChar(50)
  orderInfo            String              @map("order_info") @db.VarChar(500)
  paidAt               DateTime?           @map("paid_at")
  failedReason         String?             @map("failed_reason") @db.VarChar(500)
  requestPayload       Json                @default("{}") @map("request_payload")
  responsePayload      Json                @default("{}") @map("response_payload")
  expiresAt            DateTime?           @map("expires_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders               PaymentOrder[]
  webhookLogs          PaymentWebhookLog[]
  adminWalletLedgers   AdminWalletLedger[]

  @@index([userId])
  @@index([status])
  @@index([provider, status])
  @@index([createdAt])
  @@map("payments")
}

model PaymentOrder {
  id        String   @id @default(uuid()) @db.Uuid
  paymentId String   @map("payment_id") @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([paymentId, orderId])
  @@index([paymentId])
  @@index([orderId])
  @@map("payment_orders")
}

model PaymentWebhookLog {
  id           String          @id @default(uuid()) @db.Uuid
  paymentId    String?         @map("payment_id") @db.Uuid
  provider     PaymentProvider
  eventKey     String          @unique @map("event_key") @db.VarChar(255)
  txnRef       String          @map("txn_ref") @db.VarChar(100)
  isVerified   Boolean         @default(false) @map("is_verified")
  isSuccess    Boolean         @default(false) @map("is_success")
  responseCode String?         @map("response_code") @db.VarChar(20)
  message      String?         @db.VarChar(500)
  payload      Json
  createdAt    DateTime        @default(now()) @map("created_at")
  payment      Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([provider, txnRef])
  @@index([createdAt])
  @@map("payment_webhook_logs")
}

model AdminWallet {
  id                  String              @id @default(uuid()) @db.Uuid
  code                String              @unique @db.VarChar(50)
  escrowBalance       Decimal             @default(0) @map("escrow_balance") @db.Decimal(12, 2)
  commissionBalance   Decimal             @default(0) @map("commission_balance") @db.Decimal(12, 2)
  totalInflow         Decimal             @default(0) @map("total_inflow") @db.Decimal(12, 2)
  totalReleasedSeller Decimal             @default(0) @map("total_released_seller") @db.Decimal(12, 2)
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  ledgers             AdminWalletLedger[]

  @@map("admin_wallets")
}

model AdminWalletLedger {
  id             String                @id @default(uuid()) @db.Uuid
  adminWalletId  String                @map("admin_wallet_id") @db.Uuid
  paymentId      String?               @map("payment_id") @db.Uuid
  orderId        String?               @map("order_id") @db.Uuid
  type           AdminWalletLedgerType
  idempotencyKey String                @unique @map("idempotency_key") @db.VarChar(100)
  grossAmount    Decimal               @map("gross_amount") @db.Decimal(12, 2)
  commission     Decimal               @default(0) @db.Decimal(12, 2)
  netAmount      Decimal               @default(0) @map("net_amount") @db.Decimal(12, 2)
  note           String?               @db.VarChar(255)
  createdAt      DateTime              @default(now()) @map("created_at")
  adminWallet    AdminWallet           @relation(fields: [adminWalletId], references: [id], onDelete: Cascade)
  payment        Payment?              @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  order          Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([adminWalletId])
  @@index([paymentId])
  @@index([orderId])
  @@index([type])
  @@index([createdAt])
  @@map("admin_wallet_ledgers")
}

model SellerWallet {
  id               String             @id @default(uuid()) @db.Uuid
  shopId           String             @unique @map("shop_id") @db.Uuid
  availableBalance Decimal            @default(0) @map("available_balance") @db.Decimal(12, 2)
  pendingBalance   Decimal            @default(0) @map("pending_balance") @db.Decimal(12, 2)
  totalCredited    Decimal            @default(0) @map("total_credited") @db.Decimal(12, 2)
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  shop             Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  settlements      SellerSettlement[]

  @@index([createdAt])
  @@map("seller_wallets")
}

model SellerSettlement {
  id               String                 @id @default(uuid()) @db.Uuid
  orderId          String                 @unique @map("order_id") @db.Uuid
  shopId           String                 @map("shop_id") @db.Uuid
  sellerWalletId   String                 @map("seller_wallet_id") @db.Uuid
  idempotencyKey   String                 @unique @map("idempotency_key") @db.VarChar(100)
  status           SellerSettlementStatus @default(COMPLETED)
  grossAmount      Decimal                @map("gross_amount") @db.Decimal(12, 2)
  commissionAmount Decimal                @map("commission_amount") @db.Decimal(12, 2)
  netAmount        Decimal                @map("net_amount") @db.Decimal(12, 2)
  settledAt        DateTime               @map("settled_at")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  order            Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shop             Shop                   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sellerWallet     SellerWallet           @relation(fields: [sellerWalletId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([sellerWalletId])
  @@index([status])
  @@index([createdAt])
  @@map("seller_settlements")
}

enum UserRole {
  CUSTOMER
  SELLER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
  UNVERIFIED
}

enum AuthProvider {
  GOOGLE
}

enum AddressType {
  HOME
  WORK
  OTHER
}

enum ShopStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  HIDDEN
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum SettlementStatus {
  PENDING
  SETTLED
}

enum PaymentProvider {
  VNPAY
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum AdminWalletLedgerType {
  PAYMENT_INFLOW
  SELLER_SETTLEMENT
}

enum SellerSettlementStatus {
  COMPLETED
  REVERSED
}
