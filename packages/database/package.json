{
    "name": "@repo/database",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./client": {
            "types": "./dist/client.d.ts",
            "default": "./dist/client.js"
        },
        "./schema": "./prisma/schema.prisma"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "check-types": "tsc --noEmit",
        "db:generate": "prisma generate",
        "db:push": "prisma db push",
        "db:migrate:dev": "prisma migrate dev && prisma generate",
        "db:studio": "prisma studio",
        "db:seed": "tsx src/seed.ts",
        "db:seed:catalog": "tsx src/seed.ts --mode catalog",
        "db:seed:catalog:heavy": "tsx src/seed.ts --mode catalog --products-per-category 300 --variants-min 2 --variants-max 4 --active-ratio 0.9"
    },
    "dependencies": {
        "@prisma/adapter-pg": "^7.5.0",
        "@prisma/client": "^7.5.0",
        "bcryptjs": "^3.0.3",
        "dotenv": "^17.2.3",
        "pg": "^8.16.3"
    },
    "devDependencies": {
        "@faker-js/faker": "^10.4.0",
        "@repo/typescript-config": "workspace:*",
        "@types/node": "^22.10.7",
        "@types/pg": "^8.15.6",
        "prisma": "^7.5.0",
        "tsx": "^4.21.0",
        "typescript": "5.9.2"
    }
}
