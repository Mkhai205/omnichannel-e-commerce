{
    "name": "@ecommerce/database",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./client": "./src/client.ts",
        "./schema": "./prisma/schema.prisma"
    },
    "scripts": {
